{
  "name": "@sebastienrousseau/commitlint-config",
  "version": "0.0.3",
  "description": "Shareable Conventional Commits commitlint configuration rules",
  "author": "Sebastien Rousseau <sebastienrousseau@users.noreply.github.com>",
  "license": "ISC",
  "homepage": "https://github.com/sebastienrousseau/commitlint-config#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebastienrousseau/commitlint-config.git"
  },
  "bugs": {
    "url": "https://github.com/sebastienrousseau/commitlint-config/issues"
  },
  "keywords": [
    "commitlint",
    "commitlint-config",
    "conventional-commits",
    "git-commit"
  ],
  "main": "./index.cjs",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.cjs"
    }
  },
  "files": [
    "index.js",
    "index.mjs",
    "index.cjs",
    "index.d.ts",
    "commitlint-config.svg",
    "LICENSE",
    ".editorconfig"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node test/test.js",
    "lint": "node test/test.js"
  },
  "peerDependencies": {
    "@commitlint/cli": ">=18.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.2"
  }
}
